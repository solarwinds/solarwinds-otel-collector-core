ADDLICENSE   := $(TOOLS_BIN_DIR)/addlicense

# WHY: LICENSE_YEAR is captured once per CI job (exported before make runs) to
# prevent a year-boundary race when Make and shell invocations straddle midnight.
# Falls back to date +%Y for local runs where the env var is not set.
LICENSE_YEAR ?= $(shell date +%Y)

# WHY: HEADER_LINES is derived dynamically from the template so the value stays
# correct without any manual update when the template changes.
HEADER_LINES := $(shell wc -l < $(SCRIPT_DIR)/expected-go-file-header.txt)

DEFAULT_GO_LICENSE_HEADER    := $(SCRIPT_DIR)/expected-go-file-header.txt
DEFAULT_SHELL_LICENSE_HEADER := $(SCRIPT_DIR)/expected-shell-file-header.txt

EXPECTED_GO_LICENSE_HEADER    := $(if $(EXPECTED_GO_LICENSE_HEADER),$(EXPECTED_GO_LICENSE_HEADER),$(DEFAULT_GO_LICENSE_HEADER))
EXPECTED_SHELL_LICENSE_HEADER := $(if $(EXPECTED_SHELL_LICENSE_HEADER),$(EXPECTED_SHELL_LICENSE_HEADER),$(DEFAULT_SHELL_LICENSE_HEADER))

# WHY: ci-check-licenses runs add-licenses first so check-licenses sees the
# expected state. If add-licenses modifies any file, detect-vcs-changes will
# catch the uncommitted change and fail the build — the developer must run
# `make add-licenses` locally and commit before pushing.
.PHONY: ci-check-licenses
ci-check-licenses: add-licenses check-licenses ## CI task to add and check license headers

.PHONY: add-licenses
add-licenses: $(ADDLICENSE) ## Add/update license headers on PR-changed source files only
	$(eval CHANGED_FILES := $(shell $(SCRIPT_DIR)/get-changed-license-files.sh))
	@if [ -z "$(CHANGED_FILES)" ]; then \
		echo "No changed source files detected; add-licenses is a no-op."; \
	else \
		echo "Updating license headers on changed files:"; \
		echo "$(CHANGED_FILES)"; \
		sed -i "1,$(HEADER_LINES)s/Copyright [0-9]\{4\}\(-[0-9]\{4\}\)\{0,1\} SolarWinds Worldwide, LLC/Copyright $(LICENSE_YEAR) SolarWinds Worldwide, LLC/" $(CHANGED_FILES); \
		$(ADDLICENSE) -y "$(LICENSE_YEAR)" -c "SolarWinds Worldwide, LLC. All rights reserved." -l "apache" $(CHANGED_FILES); \
	fi

.PHONY: check-licenses
check-licenses: ## Check license headers in source files
	@LICENSE_YEAR=$(LICENSE_YEAR) ADDLICENSE=$(ADDLICENSE) $(SCRIPT_DIR)/check-licenses.sh $(EXPECTED_GO_LICENSE_HEADER) $(EXPECTED_SHELL_LICENSE_HEADER)
